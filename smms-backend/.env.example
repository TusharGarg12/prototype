# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/smms_db"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="replace_with_a_strong_random_secret_min_32_chars"
JWT_REFRESH_SECRET="replace_with_another_strong_random_secret_min_32_chars"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ── QR ─────────────────────────────────────────────────────────────────────────
QR_WINDOW_MINUTES=30

# ── Chatbot (Ollama) ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"
