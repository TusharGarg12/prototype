# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/smms_db"

# ── JWT ────────────────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET="replace_with_a_strong_random_secret_min_32_chars"
JWT_REFRESH_SECRET="replace_with_another_strong_random_secret_min_32_chars"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── OTP ────────────────────────────────────────────────────────────────────────
OTP_EXPIRY_MINUTES=10

# ── QR ─────────────────────────────────────────────────────────────────────────
QR_WINDOW_MINUTES=30

# ── Chatbot (Ollama) ──────────────────────────────────────────────────────────
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# ── ML Backend ────────────────────────────────────────────────────────────────
ML_BACKEND_URL="http://localhost:8000"

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASS="replace_with_smtp_api_key"
SMTP_FROM="no-reply@smms.edu"
